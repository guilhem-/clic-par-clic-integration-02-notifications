# Open WebUI : adresse et jeton d'un compte administrateur (Réglages › Compte › Clés API, ou jeton de session).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Cluster du studio : espace de noms et contexte kubectl (vide : contexte courant).
ESPACE=studio3d
KUBE_CONTEXTE=
# Adresse du compte robot dans Open WebUI (son mot de passe est généré, jamais écrit ici).
ROBOT_EMAIL=studio-3d@example.com
